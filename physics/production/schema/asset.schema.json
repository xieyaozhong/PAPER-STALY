{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-staly.local/schema/physics-asset.schema.json",
  "title": "PAPER-STALY Physics Asset",
  "type": "object",
  "required": [
    "asset_id",
    "family",
    "title",
    "audience",
    "learning_objectives",
    "misconception_tags",
    "render",
    "content",
    "qa"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^PHY-(TEACH|PRACTICE|ASSESS|DIAGNOSE|REFERENCE)-[A-Z0-9-]+-[0-9]{3}$"
    },
    "family": {
      "enum": ["teach", "practice", "assess", "diagnose", "reference"]
    },
    "title": {"type": "string", "minLength": 1},
    "audience": {"enum": ["student", "teacher", "both"]},
    "subject": {"const": "physics"},
    "topic": {"type": "string"},
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"}
        }
      }
    },
    "misconception_tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "render": {
      "type": "object",
      "required": ["seed", "viewport", "theme", "fallback_fonts"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 320},
            "height": {"type": "integer", "minimum": 320}
          }
        },
        "theme": {"type": "string"},
        "fallback_fonts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "content": {
      "type": "object",
      "required": ["summary", "formulae", "diagram"],
      "properties": {
        "summary": {"type": "string"},
        "formulae": {"type": "array", "items": {"type": "string"}},
        "diagram": {"type": "string"},
        "quick_check": {"type": "array", "items": {"type": "string"}}
      }
    },
    "qa": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description", "required"],
            "properties": {
              "id": {"type": "string"},
              "description": {"type": "string"},
              "required": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
